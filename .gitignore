# =============================================================================
# Venice Forge
# Repository ignore policy
#
# Keep: source, canonical documentation, packaging assets, tests, examples
# Ignore: dependencies, generated output, machine-local config, agent working
# files, diagnostics, audit scratch data, release contaminants
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies and local runtimes
# -----------------------------------------------------------------------------

/node_modules/
/.node22/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# -----------------------------------------------------------------------------
# Build, test, packaging output
# -----------------------------------------------------------------------------

/dist/
/dist-electron/
/release/
/coverage/
/.vite/
/playwright-report/
/test-results/
.eslintcache


# -----------------------------------------------------------------------------
# Build resources (generated)
# -----------------------------------------------------------------------------

/build/*
!/build/icon.ico
!/build/icon.icns
!/build/icon.png
!/build/icon-placeholder.md


# -----------------------------------------------------------------------------
# Generated application artifacts
# -----------------------------------------------------------------------------

/artifacts/
/venice-media-output/
/.local-reports/
/audit-output/
/debug-output/


# -----------------------------------------------------------------------------
# Design and development-tool output
# -----------------------------------------------------------------------------

/.design-captures/
/.impeccable/
/.superpowers/
/.freebuff/
/.playwright-cli/

/scripts/dev-tools/venice-styles.json


# -----------------------------------------------------------------------------
# Local configuration and secrets
# -----------------------------------------------------------------------------

.env*
!.env.example

/.config/*.yaml
/.config/*.yml
!.config/*.example.yaml
!.config/*.example.yml

/.config/*.local.yaml
/.config/*.local.yml

/.integration-src/


# -----------------------------------------------------------------------------
# Documentation: local/generated only
# -----------------------------------------------------------------------------

/docs/AGENTS/
/docs/HQE_AUDIT_REPORT.md
/docs/reference/venice-api-upstream/

/docs/design/*
!/docs/design/*.md

/docs/ROADMAP.md.clean

# Historical archives: keep tracked archives, ignore local session dumps
/docs/archives/*
!/docs/archives/README.md
!/docs/archives/superpowers/
!/docs/archives/work-orders/
/docs/archives/work-orders/*session*
/docs/archives/work-orders/kimi-*
/docs/archives/work-orders/writing-block*
/docs/archives/work-orders/Venice_Forge_Unified_Agent_Handoff.md
/docs/archives/work-orders/VENICE_FORGE_COMPLETE_AUDIT.md
/docs/archives/work-orders/grok_session.md
/docs/archives/session-history-pre-*.md


