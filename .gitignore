# JavaScript/Node
/patch_runner.js
/update-summary*.cjs
/update_summary.cjs
/update_latest.cjs
/scratch*.cjs
/test-apiKeySet.cjs
/test-safeStorage*.cjs
/test-save-key.cjs

# TypeScript (root-level ad-hoc only; repo tests in test/ are tracked)
/test_*.ts
/test-*.ts

/first-prompt*.txt

/.agent-backups/


